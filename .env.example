# Copie para .env e troque os valores. O .env nunca vai para o Git.
POSTGRES_HOST=localhost
POSTGRES_DB=vitrine
POSTGRES_PORT=5432

# Administrador do banco. Só o container e o make db-bootstrap usam.
POSTGRES_USER=vitrine
POSTGRES_PASSWORD=troque-esta-senha

# Um usuário por serviço (com o nome do serviço), criado pelo make db-bootstrap.
# O make troca POSTGRES_USER/POSTGRES_PASSWORD por estes ao rodar cada serviço.
CLIENTES_DB_PASSWORD=troque-esta-senha
CATALOGO_DB_PASSWORD=troque-esta-senha
PEDIDOS_DB_PASSWORD=troque-esta-senha

# Chaves aceitas pela API, separadas por vírgula, cada uma com 32+ caracteres.
# Gere com: openssl rand -hex 32
API_KEYS=troque-por-uma-chave-longa-e-aleatoria

# Serviços que o pedidos consulta. Localmente, a mesma chave de API_KEYS.
CLIENTES_URL=http://localhost:8001
CLIENTES_API_KEY=troque-por-uma-chave-longa-e-aleatoria
CATALOGO_URL=http://localhost:8002
CATALOGO_API_KEY=troque-por-uma-chave-longa-e-aleatoria
HTTP_TIMEOUT_SEGUNDOS=3

# Nível de log dos serviços (DEBUG mostra também os acessos de /health, /ready e /metrics)
LOG_LEVEL=INFO
